---
// src/pages/search.astro
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { pubDate } from "@utils/blog.ts";

// Ambil query parameter
const query = Astro.url.searchParams.get("query") || "";

// Ambil semua post yang published
const allPosts = await getCollection("blog");

// Filter post berdasarkan query
const searchResults = query
    ? allPosts.filter((post) => {
          const searchContent =
              `${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags?.join(" ") || ""}`.toLowerCase();
          return searchContent.includes(query.toLowerCase());
      })
    : [];
---

<Layout>
    <div class="container mx-auto px-4 py-12">
        <!-- Judul Hasil Pencarian -->
        <h1 class="text-2xl md:text-3xl font-bold mb-8">
            {query ? `Hasil pencarian untuk "${query}"` : "Pencarian Blog"}
        </h1>

        <!-- Form Pencarian (Mirip dengan di Header) -->
        <div class="mb-12 max-w-2xl mx-auto">
            <form action="/search" method="GET" class="flex">
                <input
                    type="search"
                    name="query"
                    value={query}
                    placeholder="Cari artikel..."
                    class="flex-grow px-4 py-3 border border-gray-300 rounded-l-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                    required
                />
                <button
                    type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-r-md transition"
                >
                    Cari
                </button>
            </form>
        </div>

        <!-- Hasil Pencarian -->
        {
            query ? (
                searchResults.length > 0 ? (
                    <div class="space-y-8">
                        {searchResults.map((post) => (
                            <article class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition">
                                <div class="flex flex-col md:flex-row gap-6">
                                    <div class="md:w-1/3">
                                        <a href={`/blog/${post.id}`}>
                                            <Image
                                                src={post.data.image.src}
                                                alt={post.data.title}
                                                class="w-full h-48 object-cover rounded-md"
                                                loading="lazy"
                                            />
                                        </a>
                                    </div>
                                    <div class="md:w-2/3">
                                        <div class="flex items-center gap-2 mb-3">
                                            <span class="bg-blue-100 text-blue-600 text-xs px-3 py-1 rounded-full">
                                                {post.data.category}
                                            </span>
                                            <span class="text-sm text-gray-500">
                                                • {1}
                                            </span>
                                        </div>
                                        <h2 class="text-xl md:text-2xl font-bold mb-2">
                                            <a
                                                href={`/blog/${post.id}`}
                                                class="hover:text-blue-600 transition"
                                            >
                                                {post.data.title}
                                            </a>
                                        </h2>
                                        <p class="text-gray-600 mb-4">
                                            {post.data.excerpt}
                                        </p>
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm text-gray-500">
                                                {pubDate(post.data.publishDate)}
                                            </span>
                                            <a
                                                href={`/blog/${post.id}`}
                                                class="text-blue-600 hover:text-blue-800 font-medium transition"
                                            >
                                                Baca Selengkapnya →
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-12 bg-gray-50 rounded-lg">
                        <svg
                            class="w-16 h-16 mx-auto text-gray-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                        <h2 class="text-xl font-medium mt-4 mb-2">
                            Tidak ditemukan hasil
                        </h2>
                        <p class="text-gray-600 mb-6">
                            Tidak ada artikel yang cocok dengan pencarian Anda
                        </p>
                        <a
                            href="/blog"
                            class="text-blue-600 hover:text-blue-800 font-medium"
                        >
                            Lihat semua artikel
                        </a>
                    </div>
                )
            ) : (
                <div class="text-center py-12 bg-gray-50 rounded-lg">
                    <h2 class="text-xl font-medium mb-4">
                        Silakan masukkan kata kunci pencarian
                    </h2>
                    <p class="text-gray-600">
                        Gunakan form di atas untuk mencari artikel di blog kami
                    </p>
                </div>
            )
        }
    </div>
</Layout>
