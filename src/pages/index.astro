---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Feature from "../components/Feature.astro";
import Testimonials from "../components/Testimonials.astro";
import CallToAction from "../components/CallToAction.astro";
---

<Layout>
	<Hero />

	<!-- Search Section -->
	<section class="py-16 bg-white" data-sal="slide-up">
		<div class="container mx-auto px-4">
			<div
				class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-lg -mt-20 relative z-10"
			>
				<h2 class="text-2xl font-bold text-center mb-6">
					Cari Properti Ideal Anda
				</h2>
				<form
					id="form-seacrh"
					class="grid grid-cols-1 md:grid-cols-4 gap-4"
				>
					<div>
						<label for="location" class="block text-gray-700 mb-2"
							>Lokasi</label
						>
						<select
							id="location"
							name="location"
							class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500"
						>
							<option>Pilih Lokasi</option>
							<option>Jakarta</option>
							<option>Bandung</option>
							<option>Surabaya</option>
						</select>
					</div>
					<div>
						<label for="type" class="block text-gray-700 mb-2"
							>Tipe</label
						>
						<select
							id="type"
							name="type"
							class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500"
						>
							<option>Semua Tipe</option>
							<option>Rumah</option>
							<option>Apartemen</option>
							<option>Tanah</option>
						</select>
					</div>
					<div>
						<label for="price" class="block text-gray-700 mb-2"
							>Harga</label
						>
						<select
							id="price"
							name="price"
							class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500"
						>
							<option>Range Harga</option>
							<option> 1 Milyar</option>
							<option>1-5 Milyar</option>
							<option> 5 Milyar</option>
						</select>
					</div>
					<div class="flex items-end">
						<button
							class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md transition"
						>
							Cari
						</button>
					</div>
				</form>
			</div>
		</div>
	</section>

	<Feature />

	<!-- Why Choose Us -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-4">
			<div class="text-center mb-12" data-sal="slide-up">
				<h2 class="text-3xl font-bold mb-4">Mengapa Memilih Kami?</h2>
				<p class="text-gray-600 max-w-2xl mx-auto">
					Kami memberikan pelayanan terbaik untuk kebutuhan properti
					Anda
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div
					class="text-center p-6 rounded-lg"
					data-sal="slide-up"
					data-sal-delay="100"
				>
					<div
						class="bg-blue-100 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4"
					>
						<svg
							class="w-8 h-8 text-blue-600"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-2">Terpercaya</h3>
					<p class="text-gray-600">
						Lebih dari 10 tahun pengalaman di industri properti
						dengan ribuan klien puas
					</p>
				</div>

				<div
					class="text-center p-6 rounded-lg"
					data-sal="slide-up"
					data-sal-delay="200"
				>
					<div
						class="bg-blue-100 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4"
					>
						<svg
							class="w-8 h-8 text-blue-600"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-2">Harga Terbaik</h3>
					<p class="text-gray-600">
						Kami memberikan harga kompetitif dengan nilai terbaik
						untuk properti Anda
					</p>
				</div>

				<div
					class="text-center p-6 rounded-lg"
					data-sal="slide-up"
					data-sal-delay="300"
				>
					<div
						class="bg-blue-100 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4"
					>
						<svg
							class="w-8 h-8 text-blue-600"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
							></path>
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-2">Aman & Nyaman</h3>
					<p class="text-gray-600">
						Proses transaksi yang aman dan didampingi oleh
						profesional kami
					</p>
				</div>
			</div>
		</div>
	</section>

	<CallToAction />

	<Testimonials />
</Layout>
