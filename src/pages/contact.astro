---
// src/pages/contact.astro
import Layout from "@layouts/Layout.astro";

// Data kontak kantor
const offices = [
    {
        city: "Jakarta",
        address: "Jl. Sudirman No. 123, Jakarta Selatan",
        phone: "+62 21 1234 5678",
        email: "jakarta@realestate.co.id",
        hours: "Senin-Jumat: 9:00 - 17:00",
    },
    {
        city: "Bandung",
        address: "Jl. Asia Afrika No. 100, Bandung",
        phone: "+62 22 8765 4321",
        email: "bandung@realestate.co.id",
        hours: "Senin-Jumat: 9:00 - 17:00",
    },
];
---

<Layout>
    <!-- Hero Section -->
    <section class="relative bg-blue-700 text-white py-20 md:py-28">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-6" data-sal="slide-up">
                Hubungi Kami
            </h1>
            <p
                class="text-xl md:text-2xl max-w-3xl mx-auto"
                data-sal="slide-up"
                data-sal-delay="100"
            >
                Tim kami siap membantu Anda menemukan properti impian
            </p>
        </div>
    </section>

    <!-- Contact Grid -->
    <section class="py-16 md:py-24">
        <div class="container mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-12">
                <!-- Contact Form -->
                <div
                    class="bg-white p-8 rounded-xl shadow-md"
                    data-sal="slide-right"
                >
                    <h2 class="text-2xl font-bold mb-6">Kirim Pesan</h2>

                    <form class="space-y-6" name="contact" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="name"
                                    class="block text-gray-700 mb-2"
                                    >Nama Lengkap</label
                                >
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                                />
                            </div>
                            <div>
                                <label
                                    for="email"
                                    class="block text-gray-700 mb-2"
                                    >Email</label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                                />
                            </div>
                        </div>

                        <div>
                            <label for="phone" class="block text-gray-700 mb-2"
                                >Nomor Telepon</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                            />
                        </div>

                        <div>
                            <label
                                for="subject"
                                class="block text-gray-700 mb-2">Subjek</label
                            >
                            <select
                                id="subject"
                                name="subject"
                                class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                            >
                                <option value="">Pilih subjek...</option>
                                <option value="property-inquiry"
                                    >Pertanyaan Properti</option
                                >
                                <option value="appointment"
                                    >Buat Janji Temu</option
                                >
                                <option value="partnership"
                                    >Kerjasama Bisnis</option
                                >
                                <option value="other">Lainnya</option>
                            </select>
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-gray-700 mb-2">Pesan</label
                            >
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 px-6 rounded-md font-medium transition"
                        >
                            Kirim Pesan
                        </button>
                    </form>
                </div>

                <!-- Contact Info -->
                <div data-sal="slide-left">
                    <div class="space-y-8">
                        <div>
                            <h2 class="text-2xl font-bold mb-6">
                                Informasi Kontak
                            </h2>
                            <p class="text-gray-600 mb-6">
                                Tim profesional kami siap membantu Anda dari
                                Senin hingga Jumat, pukul 9:00 - 17:00 WIB.
                            </p>

                            <div class="space-y-4">
                                <div class="flex items-start">
                                    <div
                                        class="bg-blue-100 p-2 rounded-full mr-4"
                                    >
                                        <svg
                                            class="w-5 h-5 text-blue-600"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-800">
                                            Telepon
                                        </h3>
                                        <a
                                            href="tel:+622112345678"
                                            class="text-blue-600 hover:text-blue-800 transition"
                                            >+62 21 1234 5678</a
                                        >
                                    </div>
                                </div>

                                <div class="flex items-start">
                                    <div
                                        class="bg-blue-100 p-2 rounded-full mr-4"
                                    >
                                        <svg
                                            class="w-5 h-5 text-blue-600"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-800">
                                            Email
                                        </h3>
                                        <a
                                            href="mailto:info@realestate.co.id"
                                            class="text-blue-600 hover:text-blue-800 transition"
                                            >info@realestate.co.id</a
                                        >
                                    </div>
                                </div>

                                <div class="flex items-start">
                                    <div
                                        class="bg-blue-100 p-2 rounded-full mr-4"
                                    >
                                        <svg
                                            class="w-5 h-5 text-blue-600"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                            ></path>
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="font-bold text-gray-800">
                                            Alamat Kantor Pusat
                                        </h3>
                                        <p class="text-gray-600">
                                            Jl. Sudirman No. 123, Jakarta
                                            Selatan, DKI Jakarta 12190
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Office Locations -->
                        <div>
                            <h3 class="text-xl font-bold mb-4">Kantor Kami</h3>
                            <div class="space-y-4">
                                {
                                    offices.map((office) => (
                                        <div class="bg-gray-50 p-4 rounded-lg">
                                            <h4 class="font-bold text-gray-800">
                                                {office.city}
                                            </h4>
                                            <p class="text-gray-600 text-sm mt-1">
                                                {office.address}
                                            </p>
                                            <div class="mt-2 flex items-center text-sm text-gray-500">
                                                <svg
                                                    class="w-4 h-4 mr-1"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                                    />
                                                </svg>
                                                {office.hours}
                                            </div>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="pb-16 md:pb-24">
        <div class="container mx-auto px-4">
            <div class="bg-white rounded-xl shadow-md overflow-hidden">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.521260322283!2d106.81956135000001!3d-6.1947419999999945!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f5390917b759%3A0x6b45e839560ef85!2sMonumen%20Nasional!5e0!3m2!1sen!2sid!4v1623394257720!5m2!1sen!2sid"
                    width="100%"
                    height="450"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"></iframe>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold mb-4" data-sal="slide-up">
                    Pertanyaan Umum
                </h2>
                <p
                    class="text-gray-600 max-w-2xl mx-auto"
                    data-sal="slide-up"
                    data-sal-delay="100"
                >
                    Temukan jawaban untuk pertanyaan yang sering diajukan
                </p>
            </div>

            <div class="max-w-3xl mx-auto space-y-4">
                <div
                    class="bg-white p-6 rounded-lg shadow-sm"
                    data-sal="slide-up"
                >
                    <button
                        class="flex justify-between items-center w-full text-left"
                    >
                        <h3 class="font-bold text-lg">
                            Bagaimana cara mengetahui harga properti?
                        </h3>
                        <svg
                            class="w-5 h-5 text-blue-600 transform transition-transform duration-300"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    <div class="mt-3 text-gray-600 hidden">
                        Anda dapat menghubungi agen kami untuk mendapatkan
                        informasi harga terbaru. Kami juga menyediakan perkiraan
                        harga di website untuk properti tertentu.
                    </div>
                </div>

                <!-- Tambahkan FAQ lainnya... -->
            </div>
        </div>
    </section>
</Layout>

<!-- Script untuk animasi dan interaksi -->
<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        // Toggle FAQ
        document.querySelectorAll(".faq button").forEach((button) => {
            button.addEventListener("click", () => {
                const faqItem = button.parentElement;
                const content = button.nextElementSibling;
                const icon = button.querySelector("svg");

                faqItem.classList.toggle("active");
                content.classList.toggle("hidden");
                icon.classList.toggle("rotate-180");
            });
        });

        // Validasi form
        const form = document.querySelector("form");
        if (form) {
            form.addEventListener("submit", (e) => {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    // Tambahkan logika notifikasi error
                }
            });
        }
    });
</script>
