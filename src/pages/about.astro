---
import { Image } from "astro:assets";

import Layout from "@layouts/Layout.astro";
import CallToAction from "@components/CallToAction.astro";

import office from "@assets/images/office.webp";
import ceo from "@assets/images/ceo.webp";
import karyawan1 from "@assets/images/karyawan1.webp";
import karyawan2 from "@assets/images/karyawan2.webp";
import karyawan3 from "@assets/images/karyawan3.webp";

// Data tim (bisa dipindah ke file terpisah)
const teamMembers = [
    {
        name: "Budi Santoso",
        role: "Founder & CEO",
        bio: "Lebih dari 15 tahun pengalaman di industri properti",
        image: ceo,
    },
    {
        name: "Ani Wijaya",
        role: "Head of Sales",
        bio: "Spesialis properti komersial dan residensial",
        image: karyawan1,
    },
    {
        name: "Rani Wijayanti",
        role: "Sales",
        bio: "Spesialis properti komersial dan residensial",
        image: karyawan2,
    },
    {
        name: "Andra Pratama",
        role: "Head of Sales",
        bio: "Spesialis properti komersial dan residensial",
        image: karyawan3,
    },
];

// Data penghargaan
const awards = [
    {
        year: "2023",
        title: "Best Real Estate Agency",
        by: "Property Awards Indonesia",
    },
    // Penghargaan lainnya...
];

// Data mitra
const partners = [
    {
        name: "Bank Mandiri",
        logo: "/images/partners/mandiri.png",
    },
    // Mitra lainnya...
];

// Area layanan
const serviceAreas = [
    "Jakarta",
    "Bogor",
    "Depok",
    "Tangerang",
    "Bekasi",
    "Bandung",
    "Bali",
];
---

<Layout>
    <!-- Hero Section -->
    <section class="relative bg-blue-700 text-white py-20 md:py-32">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-6" data-sal="slide-up">
                Tentang Perusahaan Kami
            </h1>
            <p
                class="text-xl md:text-2xl max-w-3xl mx-auto"
                data-sal="slide-up"
                data-sal-delay="100"
            >
                Membantu Anda menemukan properti ideal sejak 2010
            </p>
        </div>
    </section>

    <!-- Company Story -->
    <section class="py-16 md:py-24 bg-white overflow-hidden">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row gap-12 items-center">
                <div class="md:w-1/2" data-sal="slide-right">
                    <Image
                        src={office}
                        alt="gedung kantor"
                        class="rounded-lg shadow-xl w-full aspect-square"
                    />
                </div>
                <div class="md:w-1/2" data-sal="slide-left">
                    <h2 class="text-3xl font-bold mb-6">Cerita Kami</h2>
                    <p class="text-gray-600 mb-4">
                        RealEstate didirikan pada tahun 2010 dengan visi untuk
                        menyederhanakan proses pencarian properti. Dimulai dari
                        kantor kecil di Jakarta, kami kini telah berkembang
                        menjadi salah satu perusahaan properti terpercaya di
                        Indonesia.
                    </p>
                    <p class="text-gray-600 mb-6">
                        Dengan lebih dari 1.000 properti terjual dan ribuan
                        klien yang puas, kami bangga menjadi mitra terpercaya
                        dalam perjalanan properti Anda.
                    </p>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-blue-50 p-4 rounded-lg">
                            <p class="text-blue-600 text-3xl font-bold">12+</p>
                            <p class="text-gray-600">Tahun Pengalaman</p>
                        </div>
                        <div class="bg-blue-50 p-4 rounded-lg">
                            <p class="text-blue-600 text-3xl font-bold">
                                1000+
                            </p>
                            <p class="text-gray-600">Properti Terjual</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Visi & Misi -->
    <section class="py-16 md:py-24 bg-gray-50 overflow-hidden">
        <div class="container mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-12">
                <div data-sal="slide-right">
                    <h2 class="text-3xl font-bold mb-6">Visi Kami</h2>
                    <p class="text-gray-600 text-lg">
                        "Menjadi platform properti terdepan yang menghubungkan
                        masyarakat dengan rumah impian mereka melalui teknologi
                        dan pelayanan terbaik"
                    </p>
                </div>
                <div data-sal="slide-left">
                    <h2 class="text-3xl font-bold mb-6">Misi Kami</h2>
                    <ul class="space-y-4 text-gray-600">
                        <li class="flex items-start">
                            <svg
                                class="w-5 h-5 text-blue-500 mr-2 mt-1 flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            <span
                                >Menyediakan akses mudah ke informasi properti
                                terupdate</span
                            >
                        </li>
                        <!-- Misi lainnya... -->
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Values -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Nilai-Nilai Kami</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Prinsip yang memandu setiap keputusan dan interaksi kami
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div
                    class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition"
                    data-sal="slide-up"
                >
                    <div
                        class="bg-blue-100 w-12 h-12 rounded-full flex items-center justify-center mb-4"
                    >
                        <svg
                            class="w-6 h-6 text-blue-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Integritas</h3>
                    <p class="text-gray-600">
                        Kami selalu jujur dan transparan dalam setiap transaksi
                    </p>
                </div>

                <!-- Tambahkan value card lainnya... -->
            </div>
        </div>
    </section>

    <!-- Our Team -->
    <section class="py-16 md:py-24 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Tim Kami</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Profesional berpengalaman yang siap membantu Anda
                </p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    teamMembers.map((member, index) => (
                        <div
                            class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition"
                            data-sal="slide-up"
                            data-sal-delay={index * 100}
                        >
                            <Image
                                src={member.image}
                                alt={member.name}
                                class="w-full h-64 object-cover"
                            />
                            <div class="p-6">
                                <h3 class="text-xl font-bold">{member.name}</h3>
                                <p class="text-blue-600 mb-2">{member.role}</p>
                                <p class="text-gray-600">{member.bio}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Awards & Recognition -->
    <section class="py-16 md:py-24 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Penghargaan</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Pengakuan atas dedikasi dan kualitas layanan kami
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {
                    awards.map((award, index) => (
                        <div
                            class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition"
                            data-sal="slide-up"
                            data-sal-delay={index * 100}
                        >
                            <div class="text-blue-600 text-4xl font-bold mb-2">
                                {award.year}
                            </div>
                            <h3 class="text-xl font-bold mb-1">
                                {award.title}
                            </h3>
                            <p class="text-gray-600">oleh {award.by}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Our Partners -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Mitra Kami</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Bekerja sama dengan institusi terpercaya
                </p>
            </div>

            <div class="flex flex-wrap justify-center gap-8">
                {
                    partners.map((partner, index) => (
                        <div
                            class="bg-white p-6 rounded-lg shadow-sm flex items-center justify-center"
                            data-sal="zoom-in"
                            data-sal-delay={index * 100}
                        >
                            <img
                                src={partner.logo}
                                alt={partner.name}
                                class="h-12 object-contain"
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Service Areas -->
    <section class="py-16 md:py-24 bg-white">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Area Layanan</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Kami melayani di berbagai wilayah di Indonesia
                </p>
            </div>

            <div class="max-w-4xl mx-auto" data-sal="slide-up">
                <div
                    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"
                >
                    {
                        serviceAreas.map((area) => (
                            <div class="bg-gray-50 hover:bg-blue-50 p-4 rounded-lg text-center transition">
                                <svg
                                    class="w-6 h-6 text-blue-600 mx-auto mb-2"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                </svg>
                                <span class="font-medium">{area}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Office Map -->
    <section class="py-16 bg-gray-50 overflow-hidden">
        <div class="container mx-auto px-4">
            <div class="text-center mb-12" data-sal="slide-up">
                <h2 class="text-3xl font-bold mb-4">Kantor Kami</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Kunjungi kantor kami untuk konsultasi langsung
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div data-sal="slide-right">
                    <div class="bg-white p-6 rounded-lg shadow-md">
                        <h3 class="text-xl font-bold mb-4">Kantor Pusat</h3>
                        <address class="not-italic text-gray-600 space-y-3">
                            <p class="flex items-start">
                                <svg
                                    class="w-5 h-5 text-blue-600 mr-2 mt-1 flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                                <span
                                    >Jl. Sudirman No. 123, Jakarta Selatan, DKI
                                    Jakarta 12190</span
                                >
                            </p>
                            <p class="flex items-center">
                                <svg
                                    class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path>
                                </svg>
                                <span>+62 21 1234 5678</span>
                            </p>
                            <p class="flex items-center">
                                <svg
                                    class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                                <span>info@realestate.co.id</span>
                            </p>
                        </address>
                    </div>
                </div>
                <div
                    class="h-96 rounded-lg overflow-hidden shadow-md"
                    data-sal="slide-left"
                >
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.521260322283!2d106.81956135000001!3d-6.1947419999999945!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f5390917b759%3A0x6b45e839560ef85!2sMonumen%20Nasional!5e0!3m2!1sen!2sid!4v1623394257720!5m2!1sen!2sid"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </section>
    <CallToAction />
</Layout>
