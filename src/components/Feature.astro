---
import { Image } from 'astro:assets';
import '@splidejs/splide/css';

import home1 from "@assets/images/home1.webp";
import home2 from "@assets/images/hero2.webp";
import home3 from "@assets/images/home3.webp";
import home4 from "@assets/images/home4.webp";

const features = [{img: home1, title: "Rumah Mewah Di Pondok Indah" , price: "4 milyar", location: "Jakarta Selatan", link: "/properties/1"},
{img: home2, title: "Apartemen Mewah Di Pondok Indah" , price: "4 milyar", location: "Jakarta Selatan", link: "/properties/1"},{img: home3, title: "Tanah Mewah Di Pondok Indah" , price: "4 milyar", location: "Jakarta Selatan", link: "/properties/1"},{img: home4, title: "Rumah Mewah Di Pondok Indah" , price: "4 milyar", location: "Jakarta Selatan", link: "/properties/1"}]
---
 <!-- Featured Properties -->
 <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12" data-sal="slide-up">
        <h2 class="text-3xl font-bold mb-4">Properti Unggulan</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Pilihan properti terbaik kami dengan kualitas premium</p>
      </div>

      <div class="splide featured-properties" data-sal="slide-up">
        <div class="splide__track">
          <ul class="splide__list">
            {features.map((f)=> 
            <!-- Property 1 -->
            <li class="splide__slide px-3">
              <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition">
                <div class="relative h-48">
                    <Image src={f.img} alt={f.title}  class="w-full h-full object-cover" />
                  <div class="absolute top-4 left-4 bg-blue-600 text-white px-3 py-1 rounded-md text-sm">
                    Baru
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-2">{f.title}</h3>
                  <p class="text-gray-600 mb-4 flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    {f.location}
                  </p>
                  <div class="flex justify-between items-center">
                    <span class="text-blue-600 font-bold">Rp {f.price}</span>
                    <a href={f.link} class="text-blue-600 hover:text-blue-800 transition">Detail</a>
                  </div>
                </div>
              </div>
            </li>
            )}
            

            <!-- Property 2-4 serupa -->
            <!-- ... -->
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    import Splide from '@splidejs/splide';

    document.addEventListener("DOMContentLoaded", ()=>{
        new Splide('.featured-properties', {
        perPage: 3,
        perMove: 1,
        gap: '2rem',
        pagination: false,
        breakpoints: {
          1024: {
            perPage: 2
          },
          640: {
            perPage: 1
          }
        }
      }).mount();
    });
  </script>