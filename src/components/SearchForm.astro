---
// src/components/SearchForm.astro
const {
    placeholder = "Cari artikel...",
    className = "",
    variant = "default",
} = Astro.props;
---

<form
    id="search-form"
    action="/search"
    method="GET"
    class={`${className} ${variant === "minimal" ? "flex items-center" : ""}`}
>
    <div class="relative flex-grow">
        <input
            id="search"
            type="search"
            name="query"
            placeholder={placeholder}
            required
            aria-label="Cari artikel"
            class={`w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition ${
                variant === "minimal" ? "pr-10" : ""
            }`}
        />
        {
            variant === "minimal" && (
                <button
                    type="submit"
                    class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-blue-600 transition"
                    aria-label="Submit search"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        />
                    </svg>
                </button>
            )
        }
    </div>

    {
        variant !== "minimal" && (
            <button
                type="submit"
                class="ml-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition whitespace-nowrap"
            >
                Cari
            </button>
        )
    }
</form>

<script is:inline>
    const input = document.getElementById("search");

    input.addEventListener("input", () => {
        const keyword = input.value.trim();
        const params = new URLSearchParams(window.location.search);

        if (keyword) {
            params.set("search", keyword);
        } else {
            params.delete("search");
        }

        // Ganti URL search tanpa reload
        const newUrl = `${window.location.pathname}?${params.toString()}`;
        history.replaceState(null, "", newUrl);
    });
</script>
